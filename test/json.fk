import uk.m4xy.fktests.api.Test
import uk.m4xy.fktests.api.Formats.*
import uk.m4xy.serialization.json.*
import fckt.collections.Maps.*

drawing: Drawing = Drawing(
  [Circle(Point(1, -2), 2.5), Dot],
  Some("tab\there \"quoted\" é"),
  mapOf([("a", Low), ("b", High)]),
  'é',
)

@Test writesValuesAsJson() = assertEquals(
  "{\"shapes\":[{\"type\":\"Circle\",\"centre\":{\"x\":1,\"y\":-2},\"radius\":2.5},{\"type\":\"Dot\"}],\"title\":\"tab\\there \\\"quoted\\\" é\",\"levels\":{\"a\":\"Low\",\"b\":\"High\"},\"mark\":\"é\"}",
  Json.encode(DrawingSerializer, drawing),
)

@Test readsBackWhatItWrites() = assertEquals(Ok(drawing), Json.decode(DrawingSerializer, Json.encode(DrawingSerializer, drawing)))

// Fields are read by name, in any order, whatever space is around them; one with a default can be
// left out, and None is null.
@Test readsFieldsInAnyOrder() = {
  assertEquals(Ok(Point(3, 0)), Json.decode(PointSerializer, " { \"x\" : 3 } "))
  assertEquals(Ok(Point(3, 4)), Json.decode(PointSerializer, "{\"y\":4,\"x\":3,\"z\":true}"))
  assertEquals(
    Ok(Drawing([], None, mapOf([]), 'x')),
    Json.decode(DrawingSerializer, "{\"mark\":\"x\",\"levels\":{},\"title\":null,\"shapes\":[]}"),
  )
}

@Test saysWhatIsntThere() = {
  assertEquals(Error("Point needs x, which isn't there"), Json.decode(PointSerializer, "{\"y\":4}"))
  assertEquals(
    Error("expected a whole number, not \"3\""),
    Json.decode(PointSerializer, "{\"x\":\"3\"}"),
  )
  assertEquals(
    Error("expected a whole number, not 3.5"),
    Json.decode(PointSerializer, "{\"x\":3.5}"),
  )
  assertEquals(
    Error("Square isn't a case of Shape"),
    Json.decode(ShapeSerializer, "{\"type\":\"Square\"}"),
  )
  assertEquals(Error("Middle isn't a case of Level"), Json.decode(LevelSerializer, "\"Middle\""))
  assertEquals(Error("expected Point, an object, not an array"), Json.decode(PointSerializer, "[]"))
}

// JSON text is read as RFC 8259 has it, and written back without its space.
@Test readsJsonText() = {
  assertEquals(
    Ok(
      JsonObject([JsonField("a", JsonArray([JsonNumber("1"), JsonNumber("-0.5e+3"), JsonBoolean(true), JsonNull])), JsonField("b", JsonString("x\ny/😀"))],
    )),
    JsonText.read("{\"a\": [1, -0.5e+3, true, null], \"b\": \"x\\ny\\/\\ud83d\\ude00\"}"),
  )
  assertEquals(Ok(JsonString("é\u0001")), JsonText.read("\"\\u00e9\\u0001\""))
  assertReadsBack(
    JsonText,
    JsonObject([JsonField("q\"\\", JsonArray([JsonString("\u0001\t"), JsonObject([])]))]),
  )
  assertEquals("\"\\u0001\"", JsonText.of(JsonString("\u0001")))
}

@Test saysWhereJsonTextIsWrong() = {
  assertEquals(Error("at 8: expected , or } after a field"), JsonText.read("{\"a\":1 \"b\":2}"))
  assertEquals(Error("at 2: a number can't start with 0"), JsonText.read("[01]"))
  assertEquals(Error("at 3: there's more after the value"), JsonText.read("1 2"))
  assertEquals(Error("at 4: the JSON ends too soon"), JsonText.read("[1,"))
  assertEquals(Error("at 3: \\x isn't an escape JSON has"), JsonText.read("\"\\x\""))
  assertEquals(Error("at 1: expected a value, not 'x'"), JsonText.read("x"))
}

// A Float is a JSON number, 1.0 for OCaml's 1.; and what isn't finite, which JSON has no number for, null.
@Test writesFloatsAsJsonHasThem() = {
  assertEquals(
    "{\"type\":\"Circle\",\"centre\":{\"x\":0,\"y\":0},\"radius\":1.0}",
    Json.encode(ShapeSerializer, Circle(Point(0), 1.0)),
  )
  assertEquals(
    "{\"type\":\"Circle\",\"centre\":{\"x\":0,\"y\":0},\"radius\":null}",
    Json.encode(ShapeSerializer, Circle(Point(0), 1.0 / 0.0)),
  )
}
