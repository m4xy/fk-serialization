// fk-serialization-processor: writes a serializer for each type marked @Serializable, as a
// processor kiln runs before compiling a project that lists it.
import uk.m4xy.kiln.fckt.Fckt
import uk.m4xy.fktests.kiln.*

project = Project(
  name = "fk-serialization-processor",
  group = "uk.m4xy",
  version = "0.1.0",
  dependencies = [library("fckt:symbols:0.1.0")],
)

plugins = [Fckt(), FkTests()]
