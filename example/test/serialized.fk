import uk.m4xy.fktests.api.Test
import uk.m4xy.serialization.json.*
import uk.m4xy.serialization.*
import uk.m4xy.serialization.Shape as SerialShape
import fckt.collections.Maps.*
import shop.*

user: User = User(
  "Ada",
  36,
  [Address("1 Road", Some(Address("Flat 2")))],
  levels = mapOf([("maths", High), ("art", Low)]),
  visits = 3,
  favourite = Some(Square(2.0, 'x')),
)

@Test writesWhatsSerializable() = assertEquals(
  "{\"full_name\":\"Ada\",\"age\":36,\"addresses\":[{\"line\":\"1 Road\",\"inner\":{\"line\":\"Flat 2\",\"inner\":null}}],\"nickname\":null,\"levels\":{\"art\":\"Low\",\"maths\":\"high\"},\"favourite\":{\"type\":\"box\",\"side\":2.0,\"label\":\"x\"}}",
  Json.encode(UserSerializer, user),
)

// What's read back is what was written, but what's @Transient, which is its default.
@Test readsBackWhatItWrites() = assertEquals(Ok(user.copy(visits = 0)), Json.decode(UserSerializer, Json.encode(UserSerializer, user)))

@Test leavesOutWhatHasADefault() = assertEquals(
  Ok(User("Bo", addresses = [], levels = mapOf([]), favourite = Some(Dot))),
  Json.decode(UserSerializer, "{\"favourite\":{\"type\":\"Dot\"},\"levels\":{},\"addresses\":[],\"full_name\":\"Bo\"}"),
)

@Test saysWhatsMissing() = {
  assertEquals(Error("shop.User needs full_name, which isn't there"), Json.decode(UserSerializer, "{\"addresses\":[],\"levels\":{},\"favourite\":null}"))
  assertEquals(Error("shape.box needs label, which isn't there"), Json.decode(ShapeSerializer, "{\"type\":\"box\",\"side\":1}"))
  assertEquals(Error("Square isn't a case of shape"), Json.decode(ShapeSerializer, "{\"type\":\"Square\"}"))
  assertEquals(Error("High isn't a case of shop.Level"), Json.decode(LevelSerializer, "\"High\""))
}

// A type in a module has a serializer named for both.
@Test writesTypesInModules() = assertEquals("{\"name\":\"pen\",\"price\":3}", Json.encode(CatalogItemSerializer, Catalog.Item("pen", 3)))

@Test describesItsShape() = assertEquals(
  "shop.User{full_name: text, age?: integer, addresses: [shop.Address], nickname?: text?, levels: {shop.Level}, favourite: shop.Shape?}",
  shown(UserSerializer.describe()),
)

@Test describesWhatItRefersTo() = assertEquals(
  "shop.Shape{Circle(radius: number) | box(side: number, label: char) | Dot()} shop.Level(Low | high) shop.Address{line: text, inner?: shop.Address?}",
  "${shown(ShapeSerializer.describe())} ${shown(LevelSerializer.describe())} ${shown(AddressSerializer.describe())}",
)

shown(shape: SerialShape): String = when (shape) {
  TextShape -> "text"
  IntegerShape -> "integer"
  NumberShape -> "number"
  BooleanShape -> "boolean"
  CharShape -> "char"
  ListShape(item) -> "[${shown(item)}]"
  OptionShape(value) -> "${shown(value)}?"
  MapShape(value) -> "{${shown(value)}}"
  RecordShape(name, fields) -> "$name{${fields.map { field(it) }.joinToString(", ")}}"
  EnumerationShape(name, values) -> "$name(${values.joinToString(" | ")})"
  CasesShape(name, cases) -> "$name{${cases.map { c -> "${c.name}(${c.fields.map { field(it) }.joinToString(", ")})" }.joinToString(" | ")}}"
  ReferenceShape(name, _) -> name
  UnknownShape -> "?"
}

field(f: ShapeField): String = "${f.name}${if (f.required) "" else "?"}: ${shown(f.shape)}"
